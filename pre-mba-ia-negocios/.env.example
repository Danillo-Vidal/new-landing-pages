# Copie para .env.local e ajuste conforme necessário. Todas as variáveis são opcionais.

# Caminho base da publicação. No GitHub Pages de projeto use "/nome-do-repo/".
VITE_BASE_PATH=/

# Provedor de acesso: "static" (fase 1, datas fixas) ou "api" (fase 2, FastAPI).
VITE_ACCESS_PROVIDER=static

# URL base da API de acesso (usada apenas quando VITE_ACCESS_PROVIDER=api).
VITE_ACCESS_API_BASE_URL=

# Permite simular datas com ?today=AAAA-MM-DD e acelerar o relógio com ?speed=60.
# Padrão: true em dev, false em produção.
VITE_ALLOW_DATE_OVERRIDE=

# Mostra "Simular reprodução" nas aulas sem vídeo (para testar a liberação).
# Padrão: true em dev, false em produção.
VITE_ALLOW_PLAYBACK_SIMULATION=
